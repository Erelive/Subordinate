# ---------------------------------------------------------------------
# PyInstaller build output
#
# SubOrdinant/ is the packaged dist folder: 1.6 GB of DLLs and .pyd
# files, all regenerated by a build. Note the trailing /* rather than a
# plain SubOrdinant/ - git cannot re-include a file whose parent
# directory is excluded, so ignoring the *contents* is what lets the
# README below survive.
# ---------------------------------------------------------------------
SubOrdinant/*
!SubOrdinant/READ-ME-FIRST.txt

build/
dist/
*.manifest
*.exe
# NB: *.spec is deliberately NOT ignored - it is the build recipe.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.egg
*.egg-info/
.eggs/

# Virtualenvs
.venv/
venv/
env/
ENV/
.python-version

# Model weights and caches - first run pulls ~1.6 GB from Hugging Face
*.bin
*.pt
*.onnx
*.gguf
*.safetensors
.cache/
huggingface/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# Editors
.vscode/
.idea/
*.swp
*~

# Windows / OS junk
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store

# Screen captures from tools\overlay_test.ps1. Regenerated by a run, and the
# script's *.log output is already ignored below - this keeps its image output
# from being the one artifact that gets committed.
overlay_test.png
overlay_dist.png

# Logs and local secrets
*.log
.env
.env.local
