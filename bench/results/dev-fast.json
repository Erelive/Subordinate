    {
     "t": 6.921,
     "source": "歯が痛いので口を開けることができません",
     "english": "My teeth hurt, so I can't open my mouth."
    },
    {
     "t": 10.184,
     "source": "週に4回フランスの授業があります",
     "english": "Four French classes a week."
    },
    {
     "t": 15.524,
     "source": "この動画ハプニングを予想装ってるけど仕込んでるのがバレバレ",
     "english": "I'm expecting this video to happen, but it's obvious that they're preparing."
    },
    {
     "t": 18.903,
     "source": "ひょっとしてこれで記憶喪失?",
     "english": "Could this be amnesia?"
    },
    {
     "t": 20.983,
     "source": "雪の日は出かけません",
     "english": "I don't go out on snowy days."
    },
    {
     "t": 25.39,
     "source": "この大学アメリカ・イギリスどっちだっけ",
     "english": "This university, america or england?"
    },
    {
     "t": 27.019,
     "source": "ありがとう",
     "english": "Thank you."
    },
    {
     "t": 28.225,
     "source": "これで結構です",
     "english": "That's enough."
    },
    {
     "t": 30.412,
     "source": "そうですねそれが一番大事だだと思います",
     "english": "Yeah, I think that's the most important thing."
    },
    {
     "t": 33.111,
     "source": "そんな演出意図誰も分からないよ",
     "english": "Nobody knows why you're doing that."
    },
    {
     "t": 36.49,
     "source": "これは日本で打売っていない食べ物です。",
     "english": "This is food that isn't sold in Japan."
    },
    {
     "t": 39.042,
     "source": "なんだかおなかすいちゃったね",
     "english": "I'm kind of hungry."
    },
    {
     "t": 42.543,
     "source": "元気ゆすぎて普通の人には理解できなくなった",
     "english": "She was so energetic that normal people could no longer understand her."
    },
    {
     "t": 46.353,
     "source": "コーヒーが飲みたいんじゃなくて落ち着いた場所で休みたいんだよ",
     "english": "I don't want to drink coffee, but rather rest in a calm place."
    },
    {
     "t": 49.651,
     "source": "今日の月はとりわけきれいだ",
     "english": "The moon is especially beautiful today."
    },
    {
     "t": 52.358,
     "source": "チャンネルを変えることなくテレビを見ていた",
     "english": "I was watching tv without changing the channel."
    }
   ],
   "statuses": []
  },
  "07_pauses": {
   "finals": [
    {
     "t": 7.305,
     "source": "木曜日停戦会談は",
     "english": "Thursday, the truce meeting"
    },
    {
     "t": 10.112,
     "source": "何の進展もないまま終了しました",
     "english": "It ended without any progress."
    },
    {
     "t": 12.583,
     "source": "ごめんなさい",
     "english": "I'm sorry."
    },
    {
     "t": 18.181,
     "source": "名前とかはなんとなく覚えてるんだけどそれ",
     "english": "I kind of remember her name, but that's..."
    },
    {
     "t": 19.438,
     "source": "以外はよく思い出せないみたいバイバイ",
     "english": "Looks like she can't remember much else. Bye bye."
    },
    {
     "t": 27.635,
     "source": "大声で泣きながら",
     "english": "She cried loudly"
    },
    {
     "t": 30.8,
     "source": "女の子は母親を探していた",
     "english": "The girl was looking for her mother."
    },
    {
     "t": 37.696,
     "source": "はい今朝の東京風はなさそうです。けどね体感はどうでしょうか。",
     "english": "Yes, it doesn't look like tokyo style this morning. But how do you feel?"
    },
    {
     "t": 38.084,
     "source": "近藤さん。",
     "english": "Kondousan."
    },
    {
     "t": 50.894,
     "source": "牧師県に備えて本当に気合を入れて勉強しなきゃ",
     "english": "I really need to study hard in preparation for the Reverend's Department."
    },
    {
     "t": 53.914,
     "source": "マンションに住んでるんだね",
     "english": "You live in an apartment."
    },
    {
     "t": 56.535,
     "source": "えっと",
     "english": "Let's see..."
